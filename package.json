{
  "name": "reachinbox-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev -w apps/api\" \"npm run worker:dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "db:migrate": "npm run migrate -w apps/api",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write apps tests scripts docs README.md compose.yaml .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
